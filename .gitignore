*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
instance/*
!instance/.gitkeep
saved_models/*
!saved_models/.gitkeep
data/*
!data/.gitkeep
reports/*
!reports/.gitkeep